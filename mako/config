anchor=top-right
layer=overlay

margin=10
outer-margin=8

width=360
height=130

padding=12
border-size=2
border-radius=5

max-visible=5
max-history=20

font=JetBrainsMono Nerd Font 11

markup=1
format=<b>%s</b>\n%b

text-alignment=left
default-timeout=6000
ignore-timeout=0

background-color=#121216EB
text-color=#d4d4d8FF
border-color=#505058D9

progress-color=over #46464CE6

icons=1
max-icon-size=48
icon-location=left

sort=-time
group-by=app-name
actions=1

on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all

[urgency=low]
background-color=#121216EB
text-color=#a1a1aaFF
border-color=#2d2d32F2
default-timeout=3500

[urgency=normal]
background-color=#121216EB
text-color=#d4d4d8FF
border-color=#505058D9
default-timeout=6000

[urgency=critical]
background-color=#2d2d32F2
text-color=#f4f4f5FF
border-color=#5a5a5FF2
default-timeout=0

